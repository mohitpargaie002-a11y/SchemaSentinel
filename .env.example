# ==============================================================================
# SchemaSentinel Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REVIEW MODE & SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE TARGET CONFIGURATION
# Note: Target allowlist strictly blocks production mutation in code.
# ------------------------------------------------------------------------------
# Staging target connection URL (allowlisted for controlled mutation)
TARGET_POSTGRES_URL=
DEMO_POSTGRES_URL=

# Production target (strictly configured as read-only / mutation blocked)
PROD_POSTGRES_URL=

# ------------------------------------------------------------------------------
# 3. GITHUB PR WORKFLOW (For Safe Migration Branch, Commit & PR Creation)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=mohitpargaie002-a11y/SchemaSentinel
GITHUB_BASE_BRANCH=master

# ------------------------------------------------------------------------------
# 4. OPTIONAL INTEGRATIONS & LLM SYNTHESIS
# ------------------------------------------------------------------------------
# Google Gemini API Key (optional for LLM agent synthesis)
GOOGLE_GENERATIVE_AI_API_KEY=
# Qodo API Key (optional webhook integration)
QODO_API_KEY=
