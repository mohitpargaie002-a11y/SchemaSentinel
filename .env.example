# ==============================================================================
# SchemaSentinel Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED FOR REVIEW MODE (Autonomous Schema Analysis, Risk Engine & Sandbox)
# ------------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. REQUIRED FOR CONTROLLED STAGING APPLY (Allowlisted Staging Profile Only)
# Note: Production mutation is strictly blocked in code by TargetRegistry.
# ------------------------------------------------------------------------------
TARGET_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/schemasentinel_staging
DEMO_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/schemasentinel_demo
# PROD_POSTGRES_URL is configured as read-only / blocked target (never mutated)
PROD_POSTGRES_URL=postgresql://read-only-prod:secret@localhost:5432/production_core

# ------------------------------------------------------------------------------
# 3. REQUIRED FOR GITHUB PR WORKFLOW (Safe Migration Branch, Commit & PR Creation)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_example_token_with_repo_scope
GITHUB_REPO=mohitpargaie002-a11y/SchemaSentinel

# ------------------------------------------------------------------------------
# 4. OPTIONAL / LLM ENHANCEMENTS
# ------------------------------------------------------------------------------
# Gemini API Key (optional for LLM agent synthesis)
GOOGLE_GENERATIVE_AI_API_KEY=
# Qodo API Key (optional webhook integration)
QODO_API_KEY=

