# SchemaSentinel Environment Configuration

# Agent / Model Configuration
MODEL_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# Or OpenAI / Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# TrueForge Harness Settings
TRUEFORGE_HOST=http://localhost:3000
TRUEFORGE_API_KEY=

# Target PostgreSQL Database (Authorized Demo / Staging Target Only)
TARGET_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/schemasentinel_demo
TARGET_ENV=staging-demo
TARGET_ID=demo-postgres

# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo

# Qodo API Configuration
QODO_API_KEY=your_qodo_api_key_here
