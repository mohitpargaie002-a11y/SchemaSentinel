{
  "name": "schemasentinel",
  "version": "0.1.0",
  "description": "An approval-gated agent harness that investigates, tests, explains, and safely applies database schema changes.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx scripts/day1-proof.ts",
    "demo:day2": "tsx scripts/day2-proof.ts",
    "demo:day3": "tsx scripts/day3-proof.ts"
  },
  "keywords": [
    "trueforge",
    "agent-harness",
    "database-migration",
    "postgres",
    "mcp",
    "schema-safety",
    "qodo"
  ],
  "author": "SchemaSentinel Team",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@truefoundry/trueforge": "^0.1.4",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
